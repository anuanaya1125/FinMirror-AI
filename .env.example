# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- FastAPI backend ---
LOG_LEVEL=INFO

# --- GenAI provider: Gemini (used by genai/client.py) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- GenAI provider: Alibaba DashScope / Qwen (present in requirements.txt) ---
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# --- Frontend ---
# Used only for local (non-Docker) runs. Overridden to http://api:9000 in Compose.
API_BASE_URL=http://localhost:9000
